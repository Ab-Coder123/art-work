{
  "name": "art-work",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "pnpm --filter @art-work/artwork-app... run build",
    "build:admin": "pnpm --filter @art-work/admin... run build",
    "start:web": "pnpm --filter @art-work/artwork-app exec next start -H 0.0.0.0",
    "start:admin": "pnpm --filter @art-work/admin exec next start -H 0.0.0.0",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "pnpm --filter @art-work/database run test",
    "db:status": "pnpm --filter @art-work/database run status",
    "db:check": "pnpm --filter @art-work/database run check",
    "db:migrate": "pnpm --filter @art-work/database run migrate",
    "db:reset": "pnpm --filter @art-work/database run reset"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "turbo": "^2.11.9",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.30",
      "zod": "^4.6.7"
    }
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=9.0.0"
  }
}
